---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for post in site.posts %}
    {% unless post.sitemap == false %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
    {% endunless %}
  {% endfor %}
  {% for entry in site.html_pages %}
    {% if entry.layout and entry.sitemap != false %}
  <url><loc>{{ entry.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc></url>
    {% endif %}
  {% endfor %}
</urlset>
